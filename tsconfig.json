{
  "compilerOptions": {
    "module": "commonjs",
    "lib": ["ESNext"],
    "target": "es2020",
    "types": ["node","jest"],

    "outDir": "./dist",
    "rootDir": "./",
    "sourceMap": false,
    "declaration": true,
    "removeComments": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "noImplicitReturns": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
